<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        TextElement.Foreground="{DynamicResource TextFill}"
        TextElement.FontFamily="{StaticResource TextFont}" TextElement.FontWeight="Bold"
        TextElement.FontSize="14"
        Padding="14" UseLayoutRounding="True" Background="Transparent">
  <StackPanel>
    <Grid>
      <TextBox x:Name="Box" Style="{StaticResource Field}" Height="46" FontSize="18" Tag="Search your groups and apps"
               Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search"/>
      <TextBlock Style="{StaticResource Glyph}" Text="&#xE721;" FontSize="16" HorizontalAlignment="Right" Margin="0,0,16,0"
                 Foreground="{DynamicResource TextFill2}" IsHitTestVisible="False"/>
    </Grid>

    <ItemsControl ItemsSource="{Binding Results}" Margin="0,10,0,0" Focusable="False">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Button Style="{StaticResource SearchRow}" Command="{Binding OpenCommand}" AutomationProperties.Name="{Binding Name}">
            <StackPanel Orientation="Horizontal">
              <Image Source="{Binding Icon}" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality"/>
              <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{DynamicResource TextFill2}"/>
              </StackPanel>
            </StackPanel>
          </Button>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <TextBlock Text="No apps match." Foreground="{DynamicResource TextFill2}" HorizontalAlignment="Center" Margin="0,18,0,12"
               Visibility="{Binding NoResults, Converter={StaticResource BoolVis}}"/>

    <TextBlock Text="↑ ↓ to choose  ·  Enter to open  ·  Esc to close" FontSize="12" Foreground="{DynamicResource TextFill3}"
               HorizontalAlignment="Center" Margin="0,10,0,0"/>
  </StackPanel>
</Border>
