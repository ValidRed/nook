<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
      xmlns:local="clr-namespace:WinGroups;assembly=Nook"
      TextElement.Foreground="{DynamicResource TextFill}"
      TextElement.FontFamily="{StaticResource TextFont}" TextElement.FontWeight="Bold"
      TextElement.FontSize="14"
      UseLayoutRounding="True">
  <Grid.RowDefinitions>
    <RowDefinition Height="44"/>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="*"/>
  </Grid.RowDefinitions>

  <Grid.Resources>
    <DataTemplate DataType="{x:Type local:GroupVM}">
      <Border x:Name="Card" Height="268" CornerRadius="22" Background="{DynamicResource CardFill}"
              BorderBrush="{DynamicResource CardStroke}" BorderThickness="1" Padding="16,26,16,16">
        <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
        <Border.Triggers>
          <EventTrigger RoutedEvent="MouseEnter">
            <BeginStoryboard>
              <Storyboard>
                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)" To="-3" Duration="0:0:0.3" EasingFunction="{StaticResource EaseOut}"/>
              </Storyboard>
            </BeginStoryboard>
          </EventTrigger>
          <EventTrigger RoutedEvent="MouseLeave">
            <BeginStoryboard>
              <Storyboard>
                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)" To="0" Duration="0:0:0.3" EasingFunction="{StaticResource EaseOut}"/>
              </Storyboard>
            </BeginStoryboard>
          </EventTrigger>
        </Border.Triggers>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Border x:Name="Tile" Width="112" Height="112" CornerRadius="28" Background="{DynamicResource TileFill}"
                  BorderBrush="{DynamicResource TileStroke}" BorderThickness="1" Padding="13" HorizontalAlignment="Center">
            <Grid>
              <!-- the color it wears on the desktop -->
              <Border Margin="-13" CornerRadius="27" Background="{Binding ColorFill}" Opacity="0.9"/>
            <ItemsControl ItemsSource="{Binding Preview}" Focusable="False" Visibility="{Binding IsGroup, Converter={StaticResource BoolVis}}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Rows="2" Columns="2"/></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Width="36" Height="36" Margin="5">
                    <Border CornerRadius="10" Background="{DynamicResource SubtleFill}" Visibility="{Binding IsEmpty, Converter={StaticResource BoolVis}}"/>
                    <Image Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
              <TextBlock Text="{Binding Glyph}" FontSize="40" Visibility="{Binding IsWorkspace, Converter={StaticResource BoolVis}}">
                <TextBlock.Style>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource Glyph}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding DarkText}" Value="True"><Setter Property="Foreground" Value="#E4000000"/></DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </Grid>
          </Border>
          <TextBlock Grid.Row="1" Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"
                     TextTrimming="CharacterEllipsis" Margin="0,14,0,0"/>
          <TextBlock Grid.Row="2" Text="{Binding CountText}" Style="{StaticResource Caption}" HorizontalAlignment="Center" VerticalAlignment="Top"/>
          <UniformGrid Grid.Row="3" Columns="2">
            <Button Style="{StaticResource SecondaryButton}" Command="{Binding EditCommand}" Margin="0,0,4,0" Padding="8,0" AutomationProperties.Name="Edit group">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE70F;" FontSize="14" Margin="0,0,8,0"/>
                <TextBlock Text="Edit"/>
              </StackPanel>
            </Button>
            <Button Style="{StaticResource DangerButton}" Command="{Binding RemoveCommand}" Margin="4,0,0,0" Padding="8,0" AutomationProperties.Name="Remove group">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE74D;" FontSize="14" Margin="0,0,8,0"/>
                <TextBlock Text="Remove"/>
              </StackPanel>
            </Button>
          </UniformGrid>
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
          <Setter TargetName="Card" Property="Background" Value="{DynamicResource CardHoverFill}"/>
        </Trigger>
        <DataTrigger Binding="{Binding IsFolderStyle}" Value="True">
          <Setter TargetName="Tile" Property="Background" Value="{StaticResource FolderFill}"/>
          <Setter TargetName="Tile" Property="BorderBrush" Value="#73A86E12"/>
          <Setter TargetName="Tile" Property="CornerRadius" Value="18"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate DataType="{x:Type local:AddGroupVM}">
      <Button Style="{StaticResource AddBox}" Height="268" Command="{Binding Command}" AutomationProperties.Name="Add Group">
        <StackPanel>
          <Border x:Name="Plus" Width="52" Height="52" CornerRadius="26" Background="{DynamicResource SubtleFill}" HorizontalAlignment="Center">
            <TextBlock x:Name="PlusGlyph" Style="{StaticResource Glyph}" Text="&#xE710;" FontSize="20"/>
          </Border>
          <TextBlock Text="{Binding Label}" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,0" HorizontalAlignment="Center"/>
        </StackPanel>
      </Button>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
          <Setter TargetName="Plus" Property="Background" Value="{DynamicResource AccentFill}"/>
          <Setter TargetName="PlusGlyph" Property="Foreground" Value="{DynamicResource OnAccent}"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </Grid.Resources>

  <!-- Title bar (the caption buttons on the right are drawn by Windows) -->
  <StackPanel x:Name="TitleBar" Orientation="Horizontal" VerticalAlignment="Center">
    <Image x:Name="TitleIcon" Source="{Binding AppIcon}" Width="16" Height="16" Margin="16,0,0,0" RenderOptions.BitmapScalingMode="HighQuality"/>
    <TextBlock Text="Nook" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center"/>
  </StackPanel>

  <!-- Tabs. The highlight slides to the tab you pick and the page slides in from that side (Windows.cs). -->
  <Border x:Name="TabBar" Grid.Row="1" HorizontalAlignment="Center" Margin="0,2,0,14" Padding="4" CornerRadius="16"
          Background="{DynamicResource CardFill}" BorderBrush="{DynamicResource CardStroke}" BorderThickness="1">
    <Grid>
      <Border x:Name="TabPill" HorizontalAlignment="Left" Width="0" CornerRadius="12" Background="{DynamicResource AccentFill}">
        <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
      </Border>
      <StackPanel x:Name="Tabs" Orientation="Horizontal">
        <ToggleButton Style="{StaticResource TabItem}" IsChecked="{Binding IsHomeNav, Mode=OneWay}" Command="{Binding GoHomeCommand}" AutomationProperties.Name="Home">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Glyph}" Text="&#xE80F;" FontSize="14" Margin="0,0,8,0"/>
            <TextBlock Text="Home" VerticalAlignment="Center"/>
            <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentFill}" Margin="8,0,0,0" VerticalAlignment="Center" ToolTip="An update is available"
                     Visibility="{Binding HasUpdate, Converter={StaticResource BoolVis}}"/>
          </StackPanel>
        </ToggleButton>
        <ToggleButton Style="{StaticResource TabItem}" IsChecked="{Binding IsGroupsNav, Mode=OneWay}" Command="{Binding GoGroupsCommand}" AutomationProperties.Name="Groups">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Glyph}" Text="&#xF0E2;" FontSize="14" Margin="0,0,8,0"/>
            <TextBlock Text="Groups" VerticalAlignment="Center"/>
          </StackPanel>
        </ToggleButton>
        <ToggleButton Style="{StaticResource TabItem}" IsChecked="{Binding IsWorkspacesNav, Mode=OneWay}" Command="{Binding GoWorkspacesCommand}" AutomationProperties.Name="Workspaces">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Glyph}" Text="&#xE737;" FontSize="14" Margin="0,0,8,0"/>
            <TextBlock Text="Workspaces" VerticalAlignment="Center"/>
          </StackPanel>
        </ToggleButton>
        <ToggleButton Style="{StaticResource TabItem}" IsChecked="{Binding IsIslandNav, Mode=OneWay}" Command="{Binding GoIslandCommand}" AutomationProperties.Name="Island">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Glyph}" Text="&#xE7F4;" FontSize="14" Margin="0,0,8,0"/>
            <TextBlock Text="Island" VerticalAlignment="Center"/>
          </StackPanel>
        </ToggleButton>
        <ToggleButton Style="{StaticResource TabItem}" IsChecked="{Binding IsClockNav, Mode=OneWay}" Command="{Binding GoClockCommand}" AutomationProperties.Name="Clock">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Glyph}" Text="&#xE823;" FontSize="14" Margin="0,0,8,0"/>
            <TextBlock Text="Clock" VerticalAlignment="Center"/>
          </StackPanel>
        </ToggleButton>
        <ToggleButton Style="{StaticResource TabItem}" IsChecked="{Binding IsTaskbarNav, Mode=OneWay}" Command="{Binding GoTaskbarCommand}" AutomationProperties.Name="Taskbar">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Glyph}" Text="&#xE90E;" FontSize="14" Margin="0,0,8,0"/>
            <TextBlock Text="Taskbar" VerticalAlignment="Center"/>
          </StackPanel>
        </ToggleButton>
      </StackPanel>
    </Grid>
  </Border>

  <Grid x:Name="Body" Grid.Row="2">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Editor header stays put while the app list scrolls -->
    <Grid x:Name="EditorHeader" Margin="48,6,48,18" Visibility="{Binding IsEditor, Converter={StaticResource BoolVis}}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Button Style="{StaticResource RoundButton}" Command="{Binding Editor.CancelCommand}" ToolTip="Back to groups" AutomationProperties.Name="Back to groups">
        <TextBlock Style="{StaticResource Glyph}" Text="&#xE72B;" FontSize="14"/>
      </Button>
      <TextBlock Grid.Column="1" Style="{StaticResource PageTitle}" Text="{Binding Editor.Title}" Margin="14,0,0,0" VerticalAlignment="Center"/>
      <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="Cancel" Command="{Binding Editor.CancelCommand}" Margin="0,0,8,0"/>
      <Button Grid.Column="3" Style="{StaticResource AccentButton}" Content="{Binding Editor.SaveLabel}" Command="{Binding Editor.SaveCommand}" IsDefault="True"/>
    </Grid>

    <ScrollViewer x:Name="Scroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <Grid Margin="48,0,48,48">

        <!-- HOME: the app's name, how to use it (closable), and settings -->
        <StackPanel x:Name="HomePage" Visibility="{Binding IsHome, Converter={StaticResource BoolVis}}">
          <TextBlock Text="{Binding AppName}" Style="{StaticResource PageTitle}" FontSize="56" HorizontalAlignment="Center" Margin="0,6,0,22"/>

          <!-- brings the tutorial back once it's been closed -->
          <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Center" Margin="0,0,0,26" Command="{Binding ShowTutorialCommand}"
                  Visibility="{Binding TutorialHidden, Converter={StaticResource BoolVis}}" AutomationProperties.Name="How to use Nook">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Glyph}" Text="&#xE897;" FontSize="14" Margin="0,0,8,0"/>
              <TextBlock Text="How to use Nook"/>
            </StackPanel>
          </Button>

          <Border CornerRadius="22" Background="{DynamicResource CardFill}" BorderBrush="{DynamicResource CardStroke}" BorderThickness="1"
                  Padding="26,22,22,24" Margin="0,0,0,8" Visibility="{Binding TutorialShown, Converter={StaticResource BoolVis}}">
            <StackPanel>
              <Grid>
                <StackPanel Margin="0,0,40,0">
                  <TextBlock Text="How to use Nook" FontFamily="{StaticResource DisplayFont}" FontSize="22"/>
                  <TextBlock Text="Four things that live on your desktop. Pick one to start; you can close this when you're done." Style="{StaticResource Caption}" FontSize="13" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Command="{Binding HideTutorialCommand}"
                        ToolTip="Close the tutorial" AutomationProperties.Name="Close the tutorial">
                  <TextBlock Style="{StaticResource Glyph}" Text="&#xE711;" FontSize="12"/>
                </Button>
              </Grid>
              <ItemsControl ItemsSource="{Binding TutorialSteps}" Focusable="False" Margin="0,18,0,0">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><local:AdaptiveGrid MinItemWidth="210" Spacing="12"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Style="{StaticResource TutorialStep}" Command="{Binding Command}" AutomationProperties.Name="{Binding Title}">
                      <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                          <Border Width="34" Height="34" CornerRadius="11" Background="{DynamicResource AccentTint}">
                            <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" FontSize="16" Foreground="{DynamicResource AccentText}"/>
                          </Border>
                          <TextBlock Text="{Binding Number}" Foreground="{DynamicResource TextFill3}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Text="{Binding Title}" FontSize="15" Margin="0,14,0,0" TextWrapping="Wrap"/>
                        <TextBlock Grid.Row="2" Text="{Binding Text}" Style="{StaticResource Caption}" FontSize="12.5" Margin="0,6,0,12" LineHeight="18"/>
                        <TextBlock Grid.Row="3" Foreground="{DynamicResource AccentText}" FontSize="13">
                          <Run Text="{Binding Go, Mode=OneWay}"/><Run Text=" ›"/>
                        </TextBlock>
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <StackPanel Orientation="Horizontal" Margin="2,16,0,0">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE721;" FontSize="13" Foreground="{DynamicResource TextFill2}" Margin="0,0,10,0"/>
                <TextBlock Text="Tip: press Ctrl + Alt + Space anywhere to find any app." Style="{StaticResource Caption}" FontSize="13" VerticalAlignment="Center"/>
              </StackPanel>
            </StackPanel>
          </Border>

          <TextBlock Text="Settings" Style="{StaticResource PageTitle}" FontSize="26" Margin="0,34,0,18"/>

          <StackPanel>
            <TextBlock Text="Behavior" Style="{StaticResource SectionLabel}"/>
            <Border CornerRadius="18" Background="{DynamicResource CardFill}" BorderBrush="{DynamicResource CardStroke}" BorderThickness="1">
              <StackPanel>
                <Grid MinHeight="68" Margin="20,10">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <ContentControl Style="{StaticResource RowIcon}" Content="&#xE7E8;"/>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Start with Windows"/>
                    <TextBlock Text="Shows your widgets and the island when you sign in, without opening this window" Style="{StaticResource Caption}"/>
                  </StackPanel>
                  <ToggleButton Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding StartWithWindows}" VerticalAlignment="Center" AutomationProperties.Name="Start with Windows"/>
                </Grid>
                <Border Height="1" Background="{DynamicResource Divider}"/>
                <Grid MinHeight="68" Margin="20,10">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <ContentControl Style="{StaticResource RowIcon}" Content="&#xE8FC;"/>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Shortcut on your desktop"/>
                    <TextBlock Text="A Nook shortcut to open this window. Nothing else on your desktop is touched." Style="{StaticResource Caption}"/>
                  </StackPanel>
                  <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="{Binding DesktopShortcutLabel}" Command="{Binding DesktopShortcutCommand}" VerticalAlignment="Center" MinWidth="96"/>
                </Grid>
                <Border Height="1" Background="{DynamicResource Divider}"/>
                <Grid MinHeight="68" Margin="20,10">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <ContentControl Style="{StaticResource RowIcon}" Content="&#xE8A7;"/>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Close a group after opening an app"/>
                    <TextBlock Text="The group tucks away as soon as an app starts" Style="{StaticResource Caption}"/>
                  </StackPanel>
                  <ToggleButton Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding CloseAfterLaunch}" VerticalAlignment="Center" AutomationProperties.Name="Close a group after opening an app"/>
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel Margin="0,28,0,0">
            <TextBlock Text="Appearance" Style="{StaticResource SectionLabel}"/>
            <Border CornerRadius="18" Background="{DynamicResource CardFill}" BorderBrush="{DynamicResource CardStroke}" BorderThickness="1">
              <StackPanel>
                <Grid MinHeight="68" Margin="20,10">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <ContentControl Style="{StaticResource RowIcon}" Content="&#xE790;"/>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Mode"/>
                    <TextBlock Text="Light or dark; follows Windows unless you pick one" Style="{StaticResource Caption}"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                    <Ellipse Width="16" Height="16" Fill="{DynamicResource AccentFill}" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding ModeLabel}" Foreground="{DynamicResource TextFill2}"/>
                  </StackPanel>
                  <ComboBox Grid.Column="3" Style="{StaticResource Combo}" SelectedIndex="{Binding ThemeIndex}" VerticalAlignment="Center" AutomationProperties.Name="Mode">
                    <ComboBoxItem Content="Use Windows setting"/>
                    <ComboBoxItem Content="Light"/>
                    <ComboBoxItem Content="Dark"/>
                  </ComboBox>
                </Grid>
                <Border Height="1" Background="{DynamicResource Divider}"/>
                <Grid MinHeight="68" Margin="20,10">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <ContentControl Style="{StaticResource RowIcon}" Content="&#xE7F7;"/>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="Window look"/>
                    <TextBlock Text="Solid colors, or frosted glass that shows a blur of what's behind this window" Style="{StaticResource Caption}"/>
                  </StackPanel>
                  <ComboBox Grid.Column="2" Style="{StaticResource Combo}" SelectedIndex="{Binding AppLookIndex}" VerticalAlignment="Center" AutomationProperties.Name="Window look">
                    <ComboBoxItem Content="Solid"/>
                    <ComboBoxItem Content="Frosted glass"/>
                  </ComboBox>
                </Grid>
                <Border Height="1" Background="{DynamicResource Divider}"/>
                <Grid MinHeight="68" Margin="20,10" IsEnabled="{Binding IsAppGlass}">
                  <Grid.Style>
                    <Style TargetType="Grid">
                      <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></Style.Triggers>
                    </Style>
                  </Grid.Style>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <ContentControl Style="{StaticResource RowIcon}" Content="&#xE706;"/>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="Window glass blur"/>
                    <TextBlock Text="How frosted this window's glass is. Only this window; widgets have their own below." Style="{StaticResource Caption}"/>
                  </StackPanel>
                  <TextBlock Grid.Column="2" Text="{Binding AppBlurText}" Foreground="{DynamicResource TextFill2}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                  <Slider Grid.Column="3" Style="{StaticResource FluentSlider}" Width="220" Minimum="0" Maximum="100" VerticalAlignment="Center"
                          Value="{Binding AppBlur}" AutomationProperties.Name="Window glass blur"/>
                </Grid>
                <Border Height="1" Background="{DynamicResource Divider}"/>
                <Grid MinHeight="68" Margin="20,10">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <ContentControl Style="{StaticResource RowIcon}" Content="&#xE771;"/>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="Accent color"/>
                    <TextBlock Text="Buttons, highlights and switches. &quot;A&quot; matches your Windows accent." Style="{StaticResource Caption}"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ItemsControl ItemsSource="{Binding AccentSwatches}" Focusable="False" VerticalAlignment="Center">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <ToggleButton Style="{StaticResource Swatch}" Background="{Binding Brush}" IsChecked="{Binding IsSelected, Mode=OneWay}"
                                        Command="{Binding Command}" ToolTip="{Binding Label}" AutomationProperties.Name="{Binding Label}">
                            <TextBlock Text="{Binding Short}" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                          </ToggleButton>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBox Style="{StaticResource Field}" Width="104" Margin="6,0,0,0" MaxLength="7" Tag="#RRGGBB"
                             Text="{Binding AccentText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Custom accent color"/>
                  </StackPanel>
                </Grid>
                <Border Height="1" Background="{DynamicResource Divider}"/>
                <Grid MinHeight="68" Margin="20,10">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <ContentControl Style="{StaticResource RowIcon}" Content="&#xE706;"/>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Widget glass blur"/>
                    <TextBlock Text="How frosted widgets and pop-ups look. All the way left is clear glass." Style="{StaticResource Caption}"/>
                  </StackPanel>
                  <TextBlock Grid.Column="2" Text="{Binding BlurText}" Foreground="{DynamicResource TextFill2}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                  <Slider Grid.Column="3" Style="{StaticResource FluentSlider}" Width="220" Minimum="0" Maximum="100" VerticalAlignment="Center"
                          Value="{Binding Blur}" AutomationProperties.Name="Glass blur"/>
                </Grid>
                <Border Height="1" Background="{DynamicResource Divider}"/>
                <Grid MinHeight="68" Margin="20,10">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <ContentControl Style="{StaticResource RowIcon}" Content="&#xF0E2;"/>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Group icon style"/>
                    <TextBlock Text="How 1×1 widgets look on your desktop" Style="{StaticResource Caption}"/>
                  </StackPanel>
                  <ComboBox Grid.Column="2" Style="{StaticResource Combo}" SelectedIndex="{Binding IconStyleIndex}" VerticalAlignment="Center" AutomationProperties.Name="Group icon style">
                    <ComboBoxItem Content="App grid"/>
                    <ComboBoxItem Content="Folder"/>
                  </ComboBox>
                </Grid>
                <Border Height="1" Background="{DynamicResource Divider}"/>
                <Grid MinHeight="68" Margin="20,10">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <ContentControl Style="{StaticResource RowIcon}" Content="&#xE8D2;"/>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Show app names in groups"/>
                    <TextBlock Text="Turn off for an icons-only look" Style="{StaticResource Caption}"/>
                  </StackPanel>
                  <ToggleButton Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding ShowNames}" VerticalAlignment="Center" AutomationProperties.Name="Show app names in groups"/>
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel Margin="0,28,0,0">
            <TextBlock Text="Widgets" Style="{StaticResource SectionLabel}"/>
            <Border CornerRadius="18" Background="{DynamicResource CardFill}" BorderBrush="{DynamicResource CardStroke}" BorderThickness="1">
              <StackPanel>
                <Grid MinHeight="68" Margin="20,10">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <ContentControl Style="{StaticResource RowIcon}" Content="&#xE72E;"/>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Lock widgets"/>
                    <TextBlock Text="Stops widgets and their apps from being dragged by accident" Style="{StaticResource Caption}"/>
                  </StackPanel>
                  <ToggleButton Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding LockWidgets}" VerticalAlignment="Center" AutomationProperties.Name="Lock widgets"/>
                </Grid>
                <Border Height="1" Background="{DynamicResource Divider}"/>
                <Grid MinHeight="68" Margin="20,10">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <ContentControl Style="{StaticResource RowIcon}" Content="&#xE721;"/>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Quick search"/>
                    <TextBlock Text="{Binding QuickSearchStatus}" Style="{StaticResource Caption}"/>
                  </StackPanel>
                  <ToggleButton Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding QuickSearch}" VerticalAlignment="Center" AutomationProperties.Name="Quick search"/>
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel Margin="0,28,0,0">
            <TextBlock Text="Backup" Style="{StaticResource SectionLabel}"/>
            <Border CornerRadius="18" Background="{DynamicResource CardFill}" BorderBrush="{DynamicResource CardStroke}" BorderThickness="1">
              <Grid MinHeight="68" Margin="20,10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <ContentControl Style="{StaticResource RowIcon}" Content="&#xE8F7;"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="Groups backup"/>
                  <TextBlock Text="Save your groups to a file, or bring them back on a new PC" Style="{StaticResource Caption}"/>
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="Import" Command="{Binding ImportCommand}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Button Grid.Column="3" Style="{StaticResource SecondaryButton}" Content="Export" Command="{Binding ExportCommand}" VerticalAlignment="Center"/>
              </Grid>
            </Border>
          </StackPanel>

          <StackPanel Margin="0,28,0,0">
            <TextBlock Text="Updates" Style="{StaticResource SectionLabel}"/>
            <Border CornerRadius="18" Background="{DynamicResource CardFill}" BorderBrush="{DynamicResource CardStroke}" BorderThickness="1">
              <StackPanel>
                <Grid MinHeight="68" Margin="20,10">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <ContentControl Style="{StaticResource RowIcon}" Content="&#xE895;"/>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding VersionText}"/>
                    <TextBlock Text="{Binding UpdateStatus}" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                  </StackPanel>
                  <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="{Binding UpdateButtonLabel}" Command="{Binding UpdateCommand}" IsEnabled="{Binding UpdateIdle}" VerticalAlignment="Center"/>
                </Grid>
                <Border Height="1" Background="{DynamicResource Divider}"/>
                <Grid MinHeight="68" Margin="20,10">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <ContentControl Style="{StaticResource RowIcon}" Content="&#xE916;"/>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="Check for updates automatically"/>
                    <TextBlock Text="Looks on GitHub a little after Nook starts, then twice a day. Updating is always your click." Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                  </StackPanel>
                  <ToggleButton Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding CheckUpdates}" VerticalAlignment="Center" AutomationProperties.Name="Check for updates automatically"/>
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel Margin="0,28,0,0">
            <TextBlock Text="About" Style="{StaticResource SectionLabel}"/>
            <Border CornerRadius="18" Background="{DynamicResource CardFill}" BorderBrush="{DynamicResource CardStroke}" BorderThickness="1">
              <StackPanel>
                <Grid MinHeight="68" Margin="20,10">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Image Source="{Binding AppIcon}" Width="20" Height="20" HorizontalAlignment="Left"/>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Nook"/>
                    <TextBlock Text="{Binding VersionText}" Style="{StaticResource Caption}"/>
                  </StackPanel>
                  <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="All releases" Command="{Binding OpenReleasesCommand}" VerticalAlignment="Center"/>
                </Grid>
                <Border Height="1" Background="{DynamicResource Divider}"/>
                <Grid MinHeight="68" Margin="20,10">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <ContentControl Style="{StaticResource RowIcon}" Content="&#xE74D;"/>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Remove Nook from this PC"/>
                    <TextBlock Text="Removes your groups, widgets and settings, and Nook's shortcut if you added one. Your other desktop icons and apps aren't touched." Style="{StaticResource Caption}"/>
                  </StackPanel>
                  <Button Grid.Column="2" Style="{StaticResource DangerButton}" Content="Remove" Command="{Binding RemoveFromPcCommand}" VerticalAlignment="Center"/>
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </StackPanel>

        <!-- GROUPS -->
        <StackPanel x:Name="GroupsPage" Visibility="{Binding IsGroups, Converter={StaticResource BoolVis}}">
          <TextBlock Text="Groups" Style="{StaticResource PageTitle}" Margin="0,14,0,24"/>
          <ItemsControl x:Name="HomeGrid" ItemsSource="{Binding HomeItems}" Focusable="False">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <local:AdaptiveGrid MinItemWidth="230" Spacing="20"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
        </StackPanel>

        <!-- WORKSPACES -->
        <StackPanel x:Name="WorkspacesPage" Visibility="{Binding IsWorkspaces, Converter={StaticResource BoolVis}}">
          <TextBlock Text="Workspaces" Style="{StaticResource PageTitle}" Margin="0,14,0,8"/>
          <TextBlock Text="A one-click button on your desktop that opens a set of apps and lays them out on a screen." Style="{StaticResource Caption}" FontSize="14" Margin="0,0,0,24"/>
          <ItemsControl ItemsSource="{Binding WorkspaceItems}" Focusable="False">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <local:AdaptiveGrid MinItemWidth="230" Spacing="20"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
        </StackPanel>

        <!-- GROUP EDITOR -->
        <StackPanel x:Name="EditorPage" Visibility="{Binding IsEditor, Converter={StaticResource BoolVis}}">
          <Border CornerRadius="22" Background="{DynamicResource CardFill}" BorderBrush="{DynamicResource CardStroke}" BorderThickness="1" Padding="24">
            <WrapPanel>
              <Grid Width="104" Height="104">
                <Border CornerRadius="26" Background="{DynamicResource TileFill}" BorderBrush="{DynamicResource TileStroke}" BorderThickness="1"/>
                <!-- the chosen tint, shown as you pick it -->
                <Border CornerRadius="26" Background="{Binding Editor.PreviewFill}" Opacity="0.9"
                        Visibility="{Binding Editor.HasTint, Converter={StaticResource BoolVis}}"/>
                <Grid Margin="12">
                  <ItemsControl ItemsSource="{Binding Editor.Preview}" Focusable="False" Visibility="{Binding Editor.IsGroup, Converter={StaticResource BoolVis}}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><UniformGrid Rows="2" Columns="2"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid Width="34" Height="34" Margin="5">
                          <Border CornerRadius="9" Background="{DynamicResource SubtleFill}" Visibility="{Binding IsEmpty, Converter={StaticResource BoolVis}}"/>
                          <Image Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Style="{StaticResource Glyph}" Text="{Binding Editor.Glyph}" FontSize="38" Foreground="{Binding Editor.PreviewText}"
                             Visibility="{Binding Editor.IsWorkspace, Converter={StaticResource BoolVis}}"/>
                </Grid>
              </Grid>
              <StackPanel Margin="28,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Editor.NameLabel}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBox Style="{StaticResource Field}" Width="300" HorizontalAlignment="Left" Tag="{Binding Editor.NamePlaceholder}"
                         Text="{Binding Editor.Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Name"/>
                <TextBlock Text="{Binding Editor.NameHint}" Style="{StaticResource Caption}" Margin="0,8,0,0" MaxWidth="300" HorizontalAlignment="Left" TextWrapping="Wrap"/>
              </StackPanel>

              <!-- Widget size, in desktop icon spaces -->
              <StackPanel Margin="32,0,0,0" VerticalAlignment="Center">
                <StackPanel Visibility="{Binding Editor.IsGroup, Converter={StaticResource BoolVis}}">
                <TextBlock Text="Widget size" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal">
                  <ToggleButton Style="{StaticResource Chip}" Content="1×1" IsChecked="{Binding Editor.Is1, Mode=OneWay}"
                                Command="{Binding Editor.SetSizeCommand}" CommandParameter="1" AutomationProperties.Name="1 by 1"/>
                  <ToggleButton Style="{StaticResource Chip}" Content="2×2" IsChecked="{Binding Editor.Is2, Mode=OneWay}" Margin="6,0,0,0"
                                Command="{Binding Editor.SetSizeCommand}" CommandParameter="2" AutomationProperties.Name="2 by 2"/>
                  <ToggleButton Style="{StaticResource Chip}" Content="3×3" IsChecked="{Binding Editor.Is3, Mode=OneWay}" Margin="6,0,0,0"
                                Command="{Binding Editor.SetSizeCommand}" CommandParameter="3" AutomationProperties.Name="3 by 3"/>
                  <Border Width="1" Height="24" Background="{DynamicResource Divider}" Margin="14,0"/>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Width" Foreground="{DynamicResource TextFill2}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Style="{StaticResource Field}" Width="48" TextAlignment="Center" MaxLength="1" Tag="1–3"
                             Text="{Binding Editor.WidthText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Widget width"/>
                    <TextBlock Text="Length" Foreground="{DynamicResource TextFill2}" VerticalAlignment="Center" Margin="14,0,8,0"/>
                    <TextBox Style="{StaticResource Field}" Width="48" TextAlignment="Center" MaxLength="1" Tag="1–3"
                             Text="{Binding Editor.LengthText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Widget length"/>
                  </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                  <ItemsControl ItemsSource="{Binding Editor.SizeCells}" Focusable="False" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><UniformGrid Rows="3" Columns="3"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border x:Name="Cell" Width="10" Height="13" Margin="1.5" CornerRadius="2.5" Background="{DynamicResource SubtleFill}"/>
                        <DataTemplate.Triggers>
                          <DataTrigger Binding="{Binding IsOn}" Value="True">
                            <Setter TargetName="Cell" Property="Background" Value="{DynamicResource AccentFill}"/>
                          </DataTrigger>
                        </DataTemplate.Triggers>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="10,0,0,0" MaxWidth="360">
                    <Run Text="{Binding Editor.SizeText, Mode=OneWay}"/><Run Text=" · each space is one desktop icon column wide, up to 3 × 3. 1×1 opens a pop-up; bigger widgets show the apps."/>
                  </TextBlock>
                </StackPanel>
                </StackPanel>

                <!-- Workspace: icon, layout and screen -->
                <StackPanel Visibility="{Binding Editor.IsWorkspace, Converter={StaticResource BoolVis}}">
                  <TextBlock Text="Icon" FontWeight="SemiBold" Margin="0,0,0,8"/>
                  <ItemsControl ItemsSource="{Binding Editor.Icons}" Focusable="False" MaxWidth="480" HorizontalAlignment="Left">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <ToggleButton Style="{StaticResource Chip}" Width="38" Height="38" Padding="0" Margin="0,0,6,6" IsChecked="{Binding IsSelected, Mode=OneWay}"
                                      Command="{Binding Command}" ToolTip="{Binding Label}" AutomationProperties.Name="{Binding Label}">
                          <TextBlock Style="{StaticResource Glyph}" Text="{Binding Short}" FontSize="16"/>
                        </ToggleButton>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <TextBlock Text="Button size" FontWeight="SemiBold" Margin="0,12,0,8"/>
                  <StackPanel Orientation="Horizontal">
                    <ToggleButton Style="{StaticResource Chip}" Content="1×1" IsChecked="{Binding Editor.Is1, Mode=OneWay}"
                                  Command="{Binding Editor.SetSizeCommand}" CommandParameter="1" AutomationProperties.Name="1 by 1"/>
                    <ToggleButton Style="{StaticResource Chip}" Content="2×2" IsChecked="{Binding Editor.Is2, Mode=OneWay}" Margin="6,0,0,0"
                                  Command="{Binding Editor.SetSizeCommand}" CommandParameter="2" AutomationProperties.Name="2 by 2"/>
                    <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,0,0,0" MaxWidth="320"
                               Text="1×1 is just the icon; 2×2 also shows where each app goes."/>
                  </StackPanel>

                  <!-- more than one screen: a tab for each, with its own layout and apps; they all open together -->
                  <StackPanel Visibility="{Binding Editor.HasScreenTabs, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="Screens" FontWeight="SemiBold" Margin="0,12,0,2"/>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,8" MaxWidth="560" HorizontalAlignment="Left" TextWrapping="Wrap"
                               Text="Pick a screen, then its layout and its apps below. Every screen with apps opens at the same time."/>
                    <ItemsControl ItemsSource="{Binding Editor.ScreenTabs}" Focusable="False">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <ToggleButton Style="{StaticResource ScreenTab}" IsChecked="{Binding IsSelected, Mode=OneWay}" Command="{Binding Command}"
                                        Margin="0,0,8,8" AutomationProperties.Name="{Binding Label}">
                            <StackPanel Orientation="Horizontal">
                              <TextBlock Style="{StaticResource Glyph}" Text="&#xE7F4;" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0"/>
                              <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Label}"/>
                                <TextBlock Text="{Binding Detail}" FontSize="11.5" Opacity="0.75"/>
                              </StackPanel>
                            </StackPanel>
                          </ToggleButton>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>

                  <TextBlock Text="{Binding Editor.LayoutTitle}" FontWeight="SemiBold" Margin="0,12,0,8"/>
                  <ItemsControl ItemsSource="{Binding Editor.Layouts}" Focusable="False" MaxWidth="560" HorizontalAlignment="Left">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <ToggleButton Style="{StaticResource Chip}" Height="Auto" Padding="10,8" Margin="0,0,8,8" IsChecked="{Binding IsSelected, Mode=OneWay}"
                                      Command="{Binding Command}" AutomationProperties.Name="{Binding Label}">
                          <StackPanel>
                            <Grid Width="64" Height="40" HorizontalAlignment="Center">
                              <Border CornerRadius="5" BorderBrush="{DynamicResource TextFill3}" BorderThickness="1"/>
                              <ItemsControl ItemsSource="{Binding Zones}" Focusable="False">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                  <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                    <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                  </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate>
                                    <Grid Width="{Binding W}" Height="{Binding H}">
                                      <Border CornerRadius="3" Background="{DynamicResource TextFill}" Opacity="0.2"/>
                                      <TextBlock Text="{Binding Number}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                              <TextBlock Style="{StaticResource Glyph}" Text="&#xE8A7;" FontSize="16" Foreground="{DynamicResource TextFill2}"
                                         Visibility="{Binding IsJustOpen, Converter={StaticResource BoolVis}}"/>
                            </Grid>
                            <TextBlock Text="{Binding Label}" FontSize="12" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                          </StackPanel>
                        </ToggleButton>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>

                <TextBlock Text="{Binding Editor.ColorLabel}" FontWeight="SemiBold" Margin="0,18,0,8"/>
                <StackPanel Orientation="Horizontal">
                  <ItemsControl ItemsSource="{Binding Editor.Swatches}" Focusable="False" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <ToggleButton Style="{StaticResource Swatch}" Background="{Binding Brush}" IsChecked="{Binding IsSelected, Mode=OneWay}"
                                      Command="{Binding Command}" ToolTip="{Binding Label}" AutomationProperties.Name="{Binding Label}">
                          <TextBlock Text="{Binding Short}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFill}"/>
                        </ToggleButton>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBox Style="{StaticResource Field}" Width="104" Margin="6,0,0,0" MaxLength="7" Tag="#RRGGBB"
                           Text="{Binding Editor.ColorText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Custom widget color"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,18,0,0" Visibility="{Binding Editor.IsGroup, Converter={StaticResource BoolVis}}">
                  <TextBlock Text="Show name" VerticalAlignment="Center" Margin="0,0,10,0"/>
                  <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding Editor.ShowTitle}" AutomationProperties.Name="Show the group name on the widget"/>
                  <TextBlock Text="Icons only" VerticalAlignment="Center" Margin="28,0,10,0"/>
                  <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding Editor.IconsOnly}" AutomationProperties.Name="Show only icons on the widget"/>
                </StackPanel>
              </StackPanel>
            </WrapPanel>
          </Border>

          <!-- The group's apps in order; drag to rearrange -->
          <Border CornerRadius="22" Background="{DynamicResource CardFill}" BorderBrush="{DynamicResource CardStroke}" BorderThickness="1"
                  Padding="20,16" Margin="0,16,0,0" Visibility="{Binding Editor.HasOrder, Converter={StaticResource BoolVis}}">
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="{Binding Editor.OrderTitle}" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Editor.OrderHint}" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
              </StackPanel>
              <ItemsControl ItemsSource="{Binding Editor.Order}" local:Reorder.Enabled="True" Focusable="False">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Width="76" Height="76" Margin="0,0,8,8" CornerRadius="14" Background="{DynamicResource SubtleFill}" Cursor="SizeAll"
                            ToolTip="{Binding Name}">
                      <Grid>
                        <StackPanel VerticalAlignment="Center">
                          <Image Source="{Binding Icon}" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality"/>
                          <TextBlock Text="{Binding Name}" FontSize="11" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="6,6,6,0"/>
                        </StackPanel>
                        <!-- the layout space this app fills -->
                        <Border Width="18" Height="18" CornerRadius="9" Background="{DynamicResource AccentFill}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,5,0"
                                Visibility="{Binding HasZone, Converter={StaticResource BoolVis}}">
                          <TextBlock Text="{Binding ZoneText}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource OnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <Grid Margin="0,32,0,14">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Choose apps" FontFamily="{StaticResource DisplayFont}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Border Grid.Column="1" CornerRadius="10" Background="{DynamicResource AccentTint}" Padding="10,3" Margin="12,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="{Binding Editor.SelectedText}" FontSize="12" Foreground="{DynamicResource AccentText}"/>
            </Border>
            <Grid Grid.Column="3" Width="260">
              <TextBox Style="{StaticResource Field}" Tag="Search apps" Text="{Binding Editor.Search, UpdateSourceTrigger=PropertyChanged}"
                       Padding="0,0,26,0" AutomationProperties.Name="Search apps"/>
              <TextBlock Style="{StaticResource Glyph}" Text="&#xE721;" FontSize="14" HorizontalAlignment="Right" Margin="0,0,12,0"
                         Foreground="{DynamicResource TextFill2}" IsHitTestVisible="False"/>
            </Grid>
            <Button Grid.Column="4" Style="{StaticResource SecondaryButton}" Command="{Binding Editor.BrowseCommand}" Margin="8,0,0,0" ToolTip="Add any app or file">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE8E5;" FontSize="14" Margin="0,0,8,0"/>
                <TextBlock Text="Browse"/>
              </StackPanel>
            </Button>
          </Grid>

          <TextBlock Text="Loading your apps…" Style="{StaticResource Caption}" Margin="4,8,0,0"
                     Visibility="{Binding Editor.IsLoading, Converter={StaticResource BoolVis}}"/>

          <TextBlock Text="Also chosen" Style="{StaticResource SectionLabel}" Visibility="{Binding Editor.HasCurrent, Converter={StaticResource BoolVis}}"/>
          <ItemsControl ItemsSource="{Binding Editor.CurrentApps}" Focusable="False" Margin="0,0,0,24" Visibility="{Binding Editor.HasCurrent, Converter={StaticResource BoolVis}}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><local:AdaptiveGrid MinItemWidth="150" Spacing="12"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <ToggleButton Style="{StaticResource PickTile}" IsChecked="{Binding IsSelected}" ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name}">
                  <StackPanel>
                    <Image Source="{Binding Icon}" Width="44" Height="44" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="{Binding Name}" FontSize="13" TextAlignment="Center" TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis" Margin="0,10,0,0"/>
                  </StackPanel>
                </ToggleButton>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Text="On your desktop" Style="{StaticResource SectionLabel}" Visibility="{Binding Editor.HasDesktop, Converter={StaticResource BoolVis}}"/>
          <ItemsControl ItemsSource="{Binding Editor.DesktopApps}" Focusable="False" Margin="0,0,0,24" Visibility="{Binding Editor.HasDesktop, Converter={StaticResource BoolVis}}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><local:AdaptiveGrid MinItemWidth="150" Spacing="12"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <ToggleButton Style="{StaticResource PickTile}" IsChecked="{Binding IsSelected}" ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name}">
                  <StackPanel>
                    <Image Source="{Binding Icon}" Width="44" Height="44" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="{Binding Name}" FontSize="13" TextAlignment="Center" TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis" Margin="0,10,0,0"/>
                  </StackPanel>
                </ToggleButton>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Text="Installed apps" Style="{StaticResource SectionLabel}" Visibility="{Binding Editor.HasInstalled, Converter={StaticResource BoolVis}}"/>
          <ItemsControl ItemsSource="{Binding Editor.InstalledApps}" Focusable="False" Margin="0,0,0,24" Visibility="{Binding Editor.HasInstalled, Converter={StaticResource BoolVis}}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><local:AdaptiveGrid MinItemWidth="150" Spacing="12"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <ToggleButton Style="{StaticResource PickTile}" IsChecked="{Binding IsSelected}" ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name}">
                  <StackPanel>
                    <Image Source="{Binding Icon}" Width="44" Height="44" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="{Binding Name}" FontSize="13" TextAlignment="Center" TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis" Margin="0,10,0,0"/>
                  </StackPanel>
                </ToggleButton>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Text="Windows apps" Style="{StaticResource SectionLabel}" Visibility="{Binding Editor.HasWindows, Converter={StaticResource BoolVis}}"/>
          <ItemsControl ItemsSource="{Binding Editor.WindowsApps}" Focusable="False" Visibility="{Binding Editor.HasWindows, Converter={StaticResource BoolVis}}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><local:AdaptiveGrid MinItemWidth="150" Spacing="12"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <ToggleButton Style="{StaticResource PickTile}" IsChecked="{Binding IsSelected}" ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name}">
                  <StackPanel>
                    <Image Source="{Binding Icon}" Width="44" Height="44" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="{Binding Name}" FontSize="13" TextAlignment="Center" TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis" Margin="0,10,0,0"/>
                  </StackPanel>
                </ToggleButton>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Text="No apps match your search." Style="{StaticResource Caption}" FontSize="14" HorizontalAlignment="Center" Margin="0,40,0,0"
                     Visibility="{Binding Editor.NoMatches, Converter={StaticResource BoolVis}}"/>
        </StackPanel>

        <!-- ISLAND -->
        <StackPanel x:Name="IslandPage" Visibility="{Binding IsIsland, Converter={StaticResource BoolVis}}">
          <TextBlock Text="Island" Style="{StaticResource PageTitle}" Margin="0,14,0,24"/>

          <!-- the top of your screen, with the island on it -->
          <Border CornerRadius="18" Height="132" ClipToBounds="True" BorderBrush="{DynamicResource CardStroke}" BorderThickness="1" Background="{Binding IslandPreviewWallpaper}">
            <Grid>
              <Border Height="34" MinWidth="{Binding IslandPreviewWidth}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="{Binding IslandPreviewMargin}"
                      CornerRadius="{Binding IslandPreviewCorners}" Background="{Binding IslandPreviewBlurred}" Opacity="{Binding IslandPreviewFrost}"/>
              <Border Height="34" MinWidth="{Binding IslandPreviewWidth}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="{Binding IslandPreviewMargin}"
                      CornerRadius="{Binding IslandPreviewCorners}" Background="{Binding IslandPreviewFill}" BorderBrush="{Binding IslandPreviewStroke}" BorderThickness="1">
                <TextBlock Text="{Binding IslandPreviewTime}" Foreground="White" FontSize="13" FontWeight="SemiBold" Margin="26,0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
              </Border>
            </Grid>
          </Border>

          <StackPanel Margin="0,28,0,0">
            <TextBlock Text="Island" Style="{StaticResource SectionLabel}"/>
            <Border CornerRadius="18" Background="{DynamicResource CardFill}" BorderBrush="{DynamicResource CardStroke}" BorderThickness="1">
              <StackPanel>
                <Grid MinHeight="68" Margin="20,10">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <ContentControl Style="{StaticResource RowIcon}" Content="&#xE7F4;"/>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="Show the island"/>
                    <TextBlock Text="The time at the top of your screen, and what&#x27;s playing. Click it for more." Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                  </StackPanel>
                  <ToggleButton Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding IslandOn}" VerticalAlignment="Center" AutomationProperties.Name="Show the island"/>
                </Grid>
                <Border Height="1" Background="{DynamicResource Divider}"/>
                <Grid MinHeight="68" Margin="20,10">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <ContentControl Style="{StaticResource RowIcon}" Content="&#xE790;"/>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="Look"/>
                    <TextBlock Text="Solid black, or frosted glass that shows a hint of what&#x27;s behind it" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                  </StackPanel>
                  <ComboBox Grid.Column="2" Style="{StaticResource Combo}" SelectedIndex="{Binding IslandStyleIndex}" VerticalAlignment="Center" AutomationProperties.Name="Look"><ComboBoxItem Content="Black"/><ComboBoxItem Content="Glass"/></ComboBox>
                </Grid>
                <Border Height="1" Background="{DynamicResource Divider}"/>
                <Grid MinHeight="68" Margin="20,10">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <ContentControl Style="{StaticResource RowIcon}" Content="&#xE771;"/>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="Tint"/>
                    <TextBlock Text="Any color you like. Light colors are deepened a little so the white text stays easy to read." Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ItemsControl ItemsSource="{Binding IslandTintSwatches}" Focusable="False" VerticalAlignment="Center">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <ToggleButton Style="{StaticResource Swatch}" Background="{Binding Brush}" IsChecked="{Binding IsSelected, Mode=OneWay}"
                                        Command="{Binding Command}" ToolTip="{Binding Label}" AutomationProperties.Name="{Binding Label}">
                            <TextBlock Text="{Binding Short}" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                          </ToggleButton>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBox Style="{StaticResource Field}" Width="104" Margin="6,0,0,0" MaxLength="7" Tag="#RRGGBB"
                             Text="{Binding IslandTintText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Custom island tint"/>
                  </StackPanel>
                </Grid>
                <Border Height="1" Background="{DynamicResource Divider}"/>
                <Grid MinHeight="68" Margin="20,10" IsEnabled="{Binding IsGlass}">
                  <Grid.Style>
                    <Style TargetType="Grid">
                      <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></Style.Triggers>
                    </Style>
                  </Grid.Style>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <ContentControl Style="{StaticResource RowIcon}" Content="&#xE706;"/>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="Glass blur"/>
                    <TextBlock Text="How frosted the glass looks. All the way left is clear glass." Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                  </StackPanel>
                  <TextBlock Grid.Column="2" Text="{Binding IslandBlurText}" Foreground="{DynamicResource TextFill2}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                  <Slider Grid.Column="3" Style="{StaticResource FluentSlider}" Width="220" Minimum="0" Maximum="100" VerticalAlignment="Center"
                          Value="{Binding IslandBlur}" AutomationProperties.Name="Island glass blur"/>
                </Grid>
                <Border Height="1" Background="{DynamicResource Divider}"/>
                <Grid MinHeight="68" Margin="20,10">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <ContentControl Style="{StaticResource RowIcon}" Content="&#xE8A1;"/>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="Shape"/>
                    <TextBlock Text="Floating sits just below the top of the screen; a notch hangs from the edge" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                  </StackPanel>
                  <ComboBox Grid.Column="2" Style="{StaticResource Combo}" SelectedIndex="{Binding IslandShapeIndex}" VerticalAlignment="Center" AutomationProperties.Name="Shape"><ComboBoxItem Content="Floating"/><ComboBoxItem Content="Notch"/></ComboBox>
                </Grid>
                <Border Height="1" Background="{DynamicResource Divider}"/>
                <Grid MinHeight="68" Margin="20,10">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <ContentControl Style="{StaticResource RowIcon}" Content="&#xE9A6;"/>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="Width"/>
                    <TextBlock Text="How wide the island is when it's resting. All the way left just fits the time." Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                  </StackPanel>
                  <TextBlock Grid.Column="2" Text="{Binding IslandWidthText}" Foreground="{DynamicResource TextFill2}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                  <Slider Grid.Column="3" Style="{StaticResource FluentSlider}" Width="220" Minimum="112" Maximum="420" VerticalAlignment="Center"
                          Value="{Binding IslandWidth}" AutomationProperties.Name="Island width"/>
                </Grid>
                <Border Height="1" Background="{DynamicResource Divider}"/>
                <Grid MinHeight="68" Margin="20,10">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <ContentControl Style="{StaticResource RowIcon}" Content="&#xE7F4;"/>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="Screen"/>
                    <TextBlock Text="Which screen the island sits on" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                  </StackPanel>
                  <ComboBox Grid.Column="2" Style="{StaticResource Combo}" ItemsSource="{Binding IslandScreenChoices}" SelectedIndex="{Binding IslandScreenIndex}" MinWidth="220" VerticalAlignment="Center" AutomationProperties.Name="Screen"/>
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel Margin="0,28,0,0">
            <TextBlock Text="On the island" Style="{StaticResource SectionLabel}"/>
            <Border CornerRadius="18" Background="{DynamicResource CardFill}" BorderBrush="{DynamicResource CardStroke}" BorderThickness="1">
              <StackPanel>
                <Grid MinHeight="68" Margin="20,10">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <ContentControl Style="{StaticResource RowIcon}" Content="&#xE8D6;"/>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="Music"/>
                    <TextBlock Text="Album art and a visualizer while music plays. Click the island for the song and controls." Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                  </StackPanel>
                  <ToggleButton Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding IslandMusic}" VerticalAlignment="Center" AutomationProperties.Name="Music"/>
                </Grid>
                <Border Height="1" Background="{DynamicResource Divider}"/>
                <Grid MinHeight="68" Margin="20,10">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <ContentControl Style="{StaticResource RowIcon}" Content="&#xE9D9;"/>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="System page"/>
                    <TextBlock Text="Open the island and scroll to see CPU, memory, GPU and network. Only read while that page is open." Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                  </StackPanel>
                  <ToggleButton Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding IslandSystem}" VerticalAlignment="Center" AutomationProperties.Name="System page"/>
                </Grid>
                <Border Height="1" Background="{DynamicResource Divider}"/>
                <Grid MinHeight="68" Margin="20,10">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <ContentControl Style="{StaticResource RowIcon}" Content="&#xE916;"/>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="Timer"/>
                    <TextBlock Text="A timer page on the island. While it runs, its countdown stays on the island, and it opens to tell you when time's up." Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                  </StackPanel>
                  <ToggleButton Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding IslandTimer}" VerticalAlignment="Center" AutomationProperties.Name="Timer"/>
                </Grid>
                <Border Height="1" Background="{DynamicResource Divider}"/>
                <Grid MinHeight="68" Margin="20,10">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <ContentControl Style="{StaticResource RowIcon}" Content="&#xE767;"/>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="Timer sound"/>
                    <TextBlock Text="Windows' alarm sound when time's up, for up to 20 seconds or until you stop it" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                  </StackPanel>
                  <ToggleButton Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding IslandTimerSound}" VerticalAlignment="Center" AutomationProperties.Name="Timer sound"/>
                </Grid>
                <Border Height="1" Background="{DynamicResource Divider}"/>
                <Grid MinHeight="68" Margin="20,10">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <ContentControl Style="{StaticResource RowIcon}" Content="&#xE7B8;"/>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="Shelf"/>
                    <TextBlock Text="Drag files, links, text or pictures onto the island to keep them, then drag them off where they go. Your files stay where they are; dragging one off copies it." Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                  </StackPanel>
                  <ToggleButton Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding IslandShelf}" VerticalAlignment="Center" AutomationProperties.Name="Shelf"/>
                </Grid>
                <Border Height="1" Background="{DynamicResource Divider}"/>
                <Grid MinHeight="68" Margin="20,10">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <ContentControl Style="{StaticResource RowIcon}" Content="&#xE7F6;"/>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="Headphones"/>
                    <TextBlock Text="Shows your headphones for a moment when they connect, with their battery when they report it" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                  </StackPanel>
                  <ToggleButton Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding IslandHeadphones}" VerticalAlignment="Center" AutomationProperties.Name="Headphones"/>
                </Grid>
                <Border Height="1" Background="{DynamicResource Divider}"/>
                <Grid MinHeight="68" Margin="20,10">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <ContentControl Style="{StaticResource RowIcon}" Content="&#xE767;"/>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="Scroll for volume"/>
                    <TextBlock Text="Scroll over the island to turn the volume up or down. When it&#x27;s open, scrolling turns the pages." Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                  </StackPanel>
                  <ToggleButton Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding IslandScrollVolume}" VerticalAlignment="Center" AutomationProperties.Name="Scroll for volume"/>
                </Grid>
                <Border Height="1" Background="{DynamicResource Divider}"/>
                <StackPanel Visibility="{Binding HasBattery, Converter={StaticResource BoolVis}}">
                <Grid MinHeight="68" Margin="20,10">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <ContentControl Style="{StaticResource RowIcon}" Content="&#xE83E;"/>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="Charging"/>
                    <TextBlock Text="Shows the battery for a moment when you plug in or unplug" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                  </StackPanel>
                  <ToggleButton Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding IslandCharging}" VerticalAlignment="Center" AutomationProperties.Name="Charging"/>
                </Grid>
                <Border Height="1" Background="{DynamicResource Divider}"/>
                </StackPanel>
                <Grid MinHeight="68" Margin="20,10">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <ContentControl Style="{StaticResource RowIcon}" Content="&#xE740;"/>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="Hide in full screen"/>
                    <TextBlock Text="Stays out of the way of games, videos and presentations" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                  </StackPanel>
                  <ToggleButton Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding IslandHideFullScreen}" VerticalAlignment="Center" AutomationProperties.Name="Hide in full screen"/>
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </StackPanel>

        <!-- CLOCK -->
        <StackPanel x:Name="ClockPage" Visibility="{Binding IsClock, Converter={StaticResource BoolVis}}">
          <TextBlock Text="Clock" Style="{StaticResource PageTitle}" Margin="0,14,0,8"/>
          <TextBlock Text="A big clock on your desktop, like a phone's lock screen. It sits behind your windows, and clicks pass straight through it." Style="{StaticResource Caption}" FontSize="14" Margin="0,0,0,24"/>

          <!-- the middle of your wallpaper, with the clock as you've set it up -->
          <Border CornerRadius="18" Height="150" ClipToBounds="True" BorderBrush="{DynamicResource CardStroke}" BorderThickness="1" Background="{Binding ClockPreviewWallpaper}" Margin="0,0,0,20">
            <Grid>
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{Binding ClockPreviewDate}" Foreground="{Binding ClockPreviewBrush}" FontFamily="{Binding ClockPreviewFont}" FontSize="14" Opacity="0.85"
                           HorizontalAlignment="Center" Visibility="{Binding ClockPreviewDateAbove, Converter={StaticResource BoolVis}}"/>
                <TextBlock Text="{Binding ClockPreviewText}" FontFamily="{Binding ClockPreviewFont}" FontWeight="{Binding ClockPreviewWeight}" Foreground="{Binding ClockPreviewBrush}"
                           FontSize="64" HorizontalAlignment="Center" LayoutTransform="{Binding ClockPreviewStretch}" Visibility="{Binding IsClockSolid, Converter={StaticResource BoolVis}}">
                  <TextBlock.Effect><DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.3" Color="Black"/></TextBlock.Effect>
                </TextBlock>
                <local:GlassText Text="{Binding ClockPreviewText}" FontFamily="{Binding ClockPreviewFont}" FontWeight="{Binding ClockPreviewWeight}" FontSize="64"
                                 Backdrop="{Binding ClockPreviewBackdrop}" Tint="{Binding ClockPreviewTint}" LayoutTransform="{Binding ClockPreviewStretch}"
                                 HorizontalAlignment="Center" Visibility="{Binding IsClockGlass, Converter={StaticResource BoolVis}}">
                  <local:GlassText.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.3" Color="Black"/></local:GlassText.Effect>
                </local:GlassText>
                <TextBlock Text="{Binding ClockPreviewDate}" Foreground="{Binding ClockPreviewBrush}" FontFamily="{Binding ClockPreviewFont}" FontSize="14" Opacity="0.85"
                           HorizontalAlignment="Center" Visibility="{Binding ClockPreviewDateBelow, Converter={StaticResource BoolVis}}"/>
              </StackPanel>
            </Grid>
          </Border>

          <Border CornerRadius="18" Background="{DynamicResource CardFill}" BorderBrush="{DynamicResource CardStroke}" BorderThickness="1">
            <StackPanel>
                <Grid MinHeight="68" Margin="20,10">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <ContentControl Style="{StaticResource RowIcon}" Content="&#xE823;"/>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="Show the clock"/>
                    <TextBlock Text="On each screen you pick below" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                  </StackPanel>
                  <ToggleButton Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding ClockOn}" VerticalAlignment="Center" AutomationProperties.Name="Show the clock"/>
                </Grid>
                <Border Height="1" Background="{DynamicResource Divider}"/>
                <Grid Margin="20,14">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <ContentControl Style="{StaticResource RowIcon}" Content="&#xE7F4;" VerticalAlignment="Top"/>
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="Screens"/>
                    <TextBlock Text="Pick one or more. With none picked, the clock uses your main screen." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <ItemsControl ItemsSource="{Binding ClockScreenChoices}" Focusable="False">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Grid Margin="0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                            <ToggleButton Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding IsChecked}" AutomationProperties.Name="{Binding Label}"/>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Grid>
                <Border Height="1" Background="{DynamicResource Divider}"/>
                <Grid MinHeight="68" Margin="20,10">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <ContentControl Style="{StaticResource RowIcon}" Content="&#xE8D3;"/>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="Size"/>
                    <TextBlock Text="How big the time is" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ClockTextSizeText}" Foreground="{DynamicResource TextFill2}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <Slider Style="{StaticResource FluentSlider}" Width="220" Minimum="48" Maximum="240" VerticalAlignment="Center"
                            Value="{Binding ClockTextSize}" AutomationProperties.Name="Clock size"/>
                  </StackPanel>
                </Grid>
                <Border Height="1" Background="{DynamicResource Divider}"/>
                <Grid MinHeight="68" Margin="20,10">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <ContentControl Style="{StaticResource RowIcon}" Content="&#xE787;"/>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="Date"/>
                    <TextBlock Text="Above the time like a phone's lock screen, under it, or not at all" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                  </StackPanel>
                  <ComboBox Grid.Column="2" Style="{StaticResource Combo}" SelectedIndex="{Binding ClockDateIndex}" VerticalAlignment="Center" AutomationProperties.Name="Date">
                    <ComboBoxItem Content="Above the time"/><ComboBoxItem Content="Under the time"/><ComboBoxItem Content="Hidden"/>
                  </ComboBox>
                </Grid>
                <Border Height="1" Background="{DynamicResource Divider}"/>
                <Grid MinHeight="68" Margin="20,10">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <ContentControl Style="{StaticResource RowIcon}" Content="&#xE8A1;"/>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="Position"/>
                    <TextBlock Text="High on the screen like a lock screen, or right in the middle" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                  </StackPanel>
                  <ComboBox Grid.Column="2" Style="{StaticResource Combo}" SelectedIndex="{Binding ClockPositionIndex}" VerticalAlignment="Center" AutomationProperties.Name="Position">
                    <ComboBoxItem Content="Upper third"/><ComboBoxItem Content="Center"/>
                  </ComboBox>
                </Grid>
                <Border Height="1" Background="{DynamicResource Divider}"/>
                <Grid MinHeight="68" Margin="20,10">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <ContentControl Style="{StaticResource RowIcon}" Content="&#xE8EC;"/>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="Glance row"/>
                    <TextBlock Text="Your battery and what's playing, small, under the time. Nothing is recorded." Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                  </StackPanel>
                  <ToggleButton Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding ClockGlance}" VerticalAlignment="Center" AutomationProperties.Name="Glance row"/>
                </Grid>
            </StackPanel>
          </Border>

          <!-- Fonts: every one shown at once, each in its own font. + adds a font file; × on a tile removes it. -->
          <TextBlock Text="Font" Style="{StaticResource SectionLabel}" Margin="4,28,0,10"/>
          <Border CornerRadius="18" Background="{DynamicResource CardFill}" BorderBrush="{DynamicResource CardStroke}" BorderThickness="1" Padding="20,16,16,20">
            <StackPanel>
              <Grid Margin="0,0,0,14">
                <StackPanel VerticalAlignment="Center" Margin="0,0,60,0">
                  <TextBlock Text="Pick a font for the clock"/>
                  <TextBlock Text="Add your own with +, and remove any you don't want with ×. Helvetica uses Arial until it's on this PC." Style="{StaticResource Caption}"/>
                </StackPanel>
                <Button Style="{StaticResource AccentButton}" Width="40" Height="40" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Command="{Binding AddClockFontCommand}" ToolTip="Add a font" AutomationProperties.Name="Add a font">
                  <TextBlock Style="{StaticResource Glyph}" Text="&#xE710;" FontSize="16"/>
                </Button>
              </Grid>
              <ItemsControl ItemsSource="{Binding ClockFontTiles}" Focusable="False">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid x:Name="Cell" Margin="0,0,12,12">
                      <Button x:Name="Tile" Style="{StaticResource FontTile}" Command="{Binding SelectCommand}" AutomationProperties.Name="{Binding Name}" ToolTip="{Binding Name}">
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock Text="{Binding DataContext.ClockPreviewText, RelativeSource={RelativeSource AncestorType=ItemsControl}}" FontFamily="{Binding Family}"
                                     FontWeight="{Binding DataContext.ClockPreviewWeight, RelativeSource={RelativeSource AncestorType=ItemsControl}}" FontSize="34" HorizontalAlignment="Center"/>
                          <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource TextFill2}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="8,2,8,0"/>
                        </StackPanel>
                      </Button>
                      <Button x:Name="Remove" Style="{StaticResource IconButton}" Width="26" Height="26" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0"
                              Command="{Binding RemoveCommand}" ToolTip="Remove this font" AutomationProperties.Name="Remove this font" Visibility="Hidden">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE711;" FontSize="10"/>
                      </Button>
                    </Grid>
                    <DataTemplate.Triggers>
                      <Trigger SourceName="Cell" Property="IsMouseOver" Value="True">
                        <Setter TargetName="Remove" Property="Visibility" Value="Visible"/>
                      </Trigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="No fonts here. Add one with +; until then the clock uses Helvetica." Style="{StaticResource Caption}" FontSize="13"
                         Visibility="{Binding NoClockFonts, Converter={StaticResource BoolVis}}"/>
            </StackPanel>
          </Border>

          <TextBlock Text="Style" Style="{StaticResource SectionLabel}" Margin="4,28,0,10"/>
          <Border CornerRadius="18" Background="{DynamicResource CardFill}" BorderBrush="{DynamicResource CardStroke}" BorderThickness="1">
            <StackPanel>
                <Grid MinHeight="68" Margin="20,10">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <ContentControl Style="{StaticResource RowIcon}" Content="&#xE7F7;"/>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="Look"/>
                    <TextBlock Text="Solid digits, or frosted glass that shows a blur of your wallpaper through them" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                  </StackPanel>
                  <ComboBox Grid.Column="2" Style="{StaticResource Combo}" SelectedIndex="{Binding ClockLookIndex}" VerticalAlignment="Center" AutomationProperties.Name="Clock look">
                    <ComboBoxItem Content="Solid"/><ComboBoxItem Content="Frosted glass"/>
                  </ComboBox>
                </Grid>
                <Border Height="1" Background="{DynamicResource Divider}"/>
                <Grid MinHeight="68" Margin="20,10" IsEnabled="{Binding IsClockGlass}">
                  <Grid.Style>
                    <Style TargetType="Grid">
                      <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></Style.Triggers>
                    </Style>
                  </Grid.Style>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <ContentControl Style="{StaticResource RowIcon}" Content="&#xE706;"/>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="Glass blur"/>
                    <TextBlock Text="How frosted the glass digits are. All the way left is clear glass." Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                  </StackPanel>
                  <TextBlock Grid.Column="2" Text="{Binding ClockGlassBlurText}" Foreground="{DynamicResource TextFill2}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                  <Slider Grid.Column="3" Style="{StaticResource FluentSlider}" Width="220" Minimum="0" Maximum="100" VerticalAlignment="Center"
                          Value="{Binding ClockGlassBlur}" AutomationProperties.Name="Clock glass blur"/>
                </Grid>
                <Border Height="1" Background="{DynamicResource Divider}"/>
                <Grid MinHeight="68" Margin="20,10" IsEnabled="{Binding IsClockGlass}">
                  <Grid.Style>
                    <Style TargetType="Grid">
                      <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></Style.Triggers>
                    </Style>
                  </Grid.Style>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <ContentControl Style="{StaticResource RowIcon}" Content="&#xE9A9;"/>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="Light sweep"/>
                    <TextBlock Text="Now and then a soft shine moves across the glass" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                  </StackPanel>
                  <ToggleButton Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding ClockShine}" VerticalAlignment="Center" AutomationProperties.Name="Light sweep"/>
                </Grid>
                <Border Height="1" Background="{DynamicResource Divider}"/>
                <Grid MinHeight="68" Margin="20,10">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <ContentControl Style="{StaticResource RowIcon}" Content="&#xE8D3;"/>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="Taller numbers"/>
                    <TextBlock Text="Stretch the digits up, like the lock screen's adjustable clock" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                  </StackPanel>
                  <TextBlock Grid.Column="2" Text="{Binding ClockStretchText}" Foreground="{DynamicResource TextFill2}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                  <Slider Grid.Column="3" Style="{StaticResource FluentSlider}" Width="220" Minimum="100" Maximum="170" VerticalAlignment="Center"
                          Value="{Binding ClockStretch}" AutomationProperties.Name="Taller numbers"/>
                </Grid>
                <Border Height="1" Background="{DynamicResource Divider}"/>
                <Grid MinHeight="68" Margin="20,10">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <ContentControl Style="{StaticResource RowIcon}" Content="&#xE8DD;"/>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="Weight"/>
                    <TextBlock Text="How thick the digits are, if the font has that weight" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                  </StackPanel>
                  <ComboBox Grid.Column="2" Style="{StaticResource Combo}" SelectedIndex="{Binding ClockWeightIndex}" VerticalAlignment="Center" AutomationProperties.Name="Weight">
                    <ComboBoxItem Content="Thin"/><ComboBoxItem Content="Light"/><ComboBoxItem Content="Regular"/><ComboBoxItem Content="Semibold"/><ComboBoxItem Content="Bold"/>
                  </ComboBox>
                </Grid>
                <Border Height="1" Background="{DynamicResource Divider}"/>
                <Grid MinHeight="68" Margin="20,10">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <ContentControl Style="{StaticResource RowIcon}" Content="&#xE790;"/>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="Color"/>
                    <TextBlock Text="The first one picks white or dark to suit your wallpaper" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ItemsControl ItemsSource="{Binding ClockColorSwatches}" Focusable="False" VerticalAlignment="Center">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <ToggleButton Style="{StaticResource Swatch}" Background="{Binding Brush}" IsChecked="{Binding IsSelected, Mode=OneWay}"
                                        Command="{Binding Command}" ToolTip="{Binding Label}" AutomationProperties.Name="{Binding Label}">
                            <TextBlock Text="{Binding Short}" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                          </ToggleButton>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBox Style="{StaticResource Field}" Width="104" Margin="6,0,0,0" MaxLength="7" Tag="#RRGGBB"
                             Text="{Binding ClockColorText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Custom clock color"/>
                  </StackPanel>
                </Grid>
                <Border Height="1" Background="{DynamicResource Divider}"/>
                <Grid MinHeight="68" Margin="20,10">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <ContentControl Style="{StaticResource RowIcon}" Content="&#xE916;"/>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="Time format"/>
                    <TextBlock Text="12-hour or 24-hour, or the same as Windows" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                  </StackPanel>
                  <ComboBox Grid.Column="2" Style="{StaticResource Combo}" SelectedIndex="{Binding ClockFormatIndex}" VerticalAlignment="Center" AutomationProperties.Name="Time format">
                    <ComboBoxItem Content="Same as Windows"/><ComboBoxItem Content="12-hour"/><ComboBoxItem Content="24-hour"/>
                  </ComboBox>
                </Grid>
                <Border Height="1" Background="{DynamicResource Divider}"/>
                <Grid MinHeight="68" Margin="20,10">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <ContentControl Style="{StaticResource RowIcon}" Content="&#xE916;"/>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="Show seconds"/>
                    <TextBlock Text="Ticks along every second" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                  </StackPanel>
                  <ToggleButton Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding ClockSeconds}" VerticalAlignment="Center" AutomationProperties.Name="Show seconds"/>
                </Grid>
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel x:Name="TaskbarPage" Visibility="{Binding IsTaskbar, Converter={StaticResource BoolVis}}">
          <TextBlock Text="Taskbar" Style="{StaticResource PageTitle}" Margin="0,14,0,8"/>
          <TextBlock Text="A few of Nook's own buttons on the empty part of your taskbar. They sit on top of it; the taskbar itself isn't changed." Style="{StaticResource Caption}" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,24"/>

          <!-- the bottom of your wallpaper, with a small copy of the taskbar and Nook's buttons on it -->
          <Border CornerRadius="18" Height="132" ClipToBounds="True" BorderBrush="{DynamicResource CardStroke}" BorderThickness="1" Background="{Binding TaskbarPreviewWallpaper}" Margin="0,0,0,20">
            <Border VerticalAlignment="Bottom" Height="48" Background="{Binding TaskbarPreviewFill}" BorderBrush="#1FFFFFFF" BorderThickness="0,1,0,0">
              <Grid Margin="10,0">
                <!-- stand-ins for the taskbar's own icons -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <StackPanel.Style>
                    <Style TargetType="StackPanel">
                      <Setter Property="HorizontalAlignment" Value="Left"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding TaskbarPreviewCentered}" Value="True"><Setter Property="HorizontalAlignment" Value="Center"/></DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </StackPanel.Style>
                  <Border Width="22" Height="22" CornerRadius="5" Margin="9,0" Background="{Binding TaskbarPreviewInk}"/>
                  <Border Width="22" Height="22" CornerRadius="5" Margin="9,0" Background="{Binding TaskbarPreviewInk}"/>
                  <Border Width="22" Height="22" CornerRadius="5" Margin="9,0" Background="{Binding TaskbarPreviewInk}"/>
                  <Border Width="22" Height="22" CornerRadius="5" Margin="9,0" Background="{Binding TaskbarPreviewInk}"/>
                </StackPanel>
                <!-- the tray -->
                <Border Width="74" Height="22" CornerRadius="5" HorizontalAlignment="Right" VerticalAlignment="Center" Background="{Binding TaskbarPreviewInk}" Opacity="0.7"/>
                <ContentControl Content="{Binding TaskbarPreviewStrip}" Focusable="False" IsTabStop="False" VerticalAlignment="Center">
                  <ContentControl.Style>
                    <Style TargetType="ContentControl">
                      <Setter Property="HorizontalAlignment" Value="Left"/>
                      <Setter Property="Margin" Value="0"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding TaskbarPreviewAtRight}" Value="True">
                          <Setter Property="HorizontalAlignment" Value="Right"/>
                          <Setter Property="Margin" Value="0,0,84,0"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding TaskbarOn}" Value="False"><Setter Property="Opacity" Value="0.35"/></DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </ContentControl.Style>
                </ContentControl>
              </Grid>
            </Border>
          </Border>

          <Border CornerRadius="18" Background="{DynamicResource CardFill}" BorderBrush="{DynamicResource CardStroke}" BorderThickness="1">
            <StackPanel>
                <Grid MinHeight="68" Margin="20,10">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <ContentControl Style="{StaticResource RowIcon}" Content="&#xE90E;"/>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="Nook on the taskbar"/>
                    <TextBlock Text="Shows the buttons you pick below. Right-click a group or workspace button for these settings." Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                  </StackPanel>
                  <ToggleButton Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding TaskbarOn}" VerticalAlignment="Center" AutomationProperties.Name="Nook on the taskbar"/>
                </Grid>
                <Border Height="1" Background="{DynamicResource Divider}"/>
                <Grid MinHeight="68" Margin="20,10">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <ContentControl Style="{StaticResource RowIcon}" Content="&#xF0E2;"/>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="Groups"/>
                    <TextBlock Text="Each group as a small button that pops open above the taskbar" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                  </StackPanel>
                  <ToggleButton Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding TaskbarGroups}" VerticalAlignment="Center" AutomationProperties.Name="Groups on the taskbar"/>
                </Grid>
                <Border Height="1" Background="{DynamicResource Divider}"/>
                <Grid MinHeight="68" Margin="20,10">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <ContentControl Style="{StaticResource RowIcon}" Content="&#xE737;"/>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="Workspaces"/>
                    <TextBlock Text="One click lays a workspace out, on both screens if it uses two" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                  </StackPanel>
                  <ToggleButton Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding TaskbarWorkspaces}" VerticalAlignment="Center" AutomationProperties.Name="Workspaces on the taskbar"/>
                </Grid>
                <Border Height="1" Background="{DynamicResource Divider}"/>
                <Grid MinHeight="68" Margin="20,10">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <ContentControl Style="{StaticResource RowIcon}" Content="&#xE7F6;"/>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="Speakers and headphones"/>
                    <TextBlock Text="Click to swap where sound plays. Right-click to pick from all of them." Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                  </StackPanel>
                  <ToggleButton Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding TaskbarSound}" VerticalAlignment="Center" AutomationProperties.Name="Sound output switch"/>
                </Grid>
                <Border Height="1" Background="{DynamicResource Divider}"/>
                <Grid MinHeight="68" Margin="20,10">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <ContentControl Style="{StaticResource RowIcon}" Content="&#xE720;"/>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="Microphone mute"/>
                    <TextBlock Text="Shows whether your mic is live. One click mutes every microphone; it glows red while they're muted." Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                  </StackPanel>
                  <ToggleButton Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding TaskbarMic}" VerticalAlignment="Center" AutomationProperties.Name="Microphone mute"/>
                </Grid>
                <Border Height="1" Background="{DynamicResource Divider}"/>
                <Grid MinHeight="68" Margin="20,10">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <ContentControl Style="{StaticResource RowIcon}" Content="&#xE8A1;"/>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="Where"/>
                    <TextBlock Text="Automatic finds the empty side: the left end with icons in the middle, or next to the tray with icons on the left" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                  </StackPanel>
                  <ComboBox Grid.Column="2" Style="{StaticResource Combo}" SelectedIndex="{Binding TaskbarSideIndex}" VerticalAlignment="Center" AutomationProperties.Name="Where on the taskbar">
                    <ComboBoxItem Content="Automatic"/><ComboBoxItem Content="Left end"/><ComboBoxItem Content="Next to the tray"/>
                  </ComboBox>
                </Grid>
            </StackPanel>
          </Border>

          <TextBlock Text="Look" Style="{StaticResource SectionLabel}" Margin="4,28,0,10"/>
          <Border CornerRadius="18" Background="{DynamicResource CardFill}" BorderBrush="{DynamicResource CardStroke}" BorderThickness="1">
            <Grid MinHeight="68" Margin="20,10">
              <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <ContentControl Style="{StaticResource RowIcon}" Content="&#xF4A5;"/>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                <TextBlock Text="See-through taskbar"/>
                <TextBlock Text="Turns Windows' own transparency effects on or off, so Start and menus change with the taskbar. Nook doesn't change the taskbar itself."
                           Style="{StaticResource Caption}" TextWrapping="Wrap"/>
              </StackPanel>
              <ToggleButton Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding SeeThroughTaskbar}" VerticalAlignment="Center" AutomationProperties.Name="See-through taskbar"/>
            </Grid>
          </Border>
        </StackPanel>

      </Grid>
    </ScrollViewer>
  </Grid>

  <!-- Confirmation dialog -->
  <Grid x:Name="DialogLayer" Grid.RowSpan="3" Background="{DynamicResource Smoke}" Visibility="Collapsed">
    <Border x:Name="DialogCard" Width="440" CornerRadius="20" Background="{DynamicResource DialogFill}" BorderBrush="{DynamicResource CardStroke}"
            BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
      <Border.Effect><DropShadowEffect BlurRadius="40" ShadowDepth="12" Direction="270" Opacity="0.3"/></Border.Effect>
      <StackPanel>
        <StackPanel Margin="28,28,28,24">
          <TextBlock Text="{Binding DialogTitle}" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding DialogMessage}" Foreground="{DynamicResource TextFill2}" TextWrapping="Wrap" Margin="0,10,0,0" LineHeight="20"/>
        </StackPanel>
        <Border Background="{DynamicResource DialogFooter}" BorderBrush="{DynamicResource CardStroke}" BorderThickness="0,1,0,0" CornerRadius="0,0,19,19" Padding="28,20">
          <UniformGrid Columns="2">
            <Button Style="{StaticResource AccentButton}" Content="{Binding DialogPrimary}" Command="{Binding DialogConfirmCommand}" Margin="0,0,5,0"/>
            <Button Style="{StaticResource SecondaryButton}" Content="Cancel" Command="{Binding DialogCancelCommand}" Margin="5,0,0,0" IsCancel="True"/>
          </UniformGrid>
        </Border>
      </StackPanel>
    </Border>
  </Grid>

  <!-- "Nook X is ready": a small note in the corner when an update is waiting -->
  <Border x:Name="UpdatePrompt" Grid.Row="2" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,28,0" Width="340" Visibility="Collapsed"
          CornerRadius="20" Background="{DynamicResource DialogFill}" BorderBrush="{DynamicResource CardStroke}" BorderThickness="1" Padding="20,18,20,18">
    <Border.Effect><DropShadowEffect BlurRadius="34" ShadowDepth="10" Direction="270" Opacity="0.35"/></Border.Effect>
    <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
    <StackPanel>
      <StackPanel Orientation="Horizontal">
        <Image Source="{Binding AppIcon}" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality"/>
        <TextBlock Text="{Binding UpdatePromptTitle}" FontFamily="{StaticResource DisplayFont}" FontSize="17" VerticalAlignment="Center" Margin="12,0,0,0"/>
      </StackPanel>
      <TextBlock Text="It downloads, checks itself against GitHub and restarts in a few seconds. Your groups and settings stay as they are."
                 Style="{StaticResource Caption}" FontSize="13" Margin="0,10,0,16" LineHeight="18"/>
      <UniformGrid Columns="2">
        <Button Style="{StaticResource AccentButton}" Content="Update now" Command="{Binding UpdatePromptInstallCommand}" Margin="0,0,5,0"/>
        <Button Style="{StaticResource SecondaryButton}" Content="Later" Command="{Binding UpdatePromptLaterCommand}" Margin="5,0,0,0"/>
      </UniformGrid>
    </StackPanel>
  </Border>

  <!-- Opening animation: the logo's four squares gather into the tile, then it glides into the title bar -->
  <!-- Undo / notice toast -->
  <Border x:Name="Toast" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,28" Visibility="Collapsed"
          CornerRadius="22" Background="{DynamicResource DialogFill}" BorderBrush="{DynamicResource CardStroke}" BorderThickness="1" Padding="20,6,6,6">
    <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.25"/></Border.Effect>
    <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
    <StackPanel Orientation="Horizontal">
      <TextBlock Text="{Binding ToastText}" VerticalAlignment="Center" Margin="0,0,14,0"/>
      <Button Style="{StaticResource AccentButton}" Content="Undo" Command="{Binding UndoCommand}" Height="32" Padding="16,0"
              Visibility="{Binding HasUndo, Converter={StaticResource BoolVis}}"/>
      <Button Style="{StaticResource IconButton}" Width="32" Height="32" Margin="4,0,0,0" Command="{Binding UndoCommand}"
              Visibility="{Binding HasUndo, Converter={StaticResource InvBoolVis}}" ToolTip="Dismiss" AutomationProperties.Name="Dismiss">
        <TextBlock Style="{StaticResource Glyph}" Text="&#xE711;" FontSize="12"/>
      </Button>
    </StackPanel>
  </Border>

  <Grid x:Name="Splash" Grid.RowSpan="3" IsHitTestVisible="False" Visibility="Collapsed" ClipToBounds="True">
    <!-- a soft glow and a ring of light behind the logo -->
    <Ellipse x:Name="SplashGlow" Width="360" Height="360" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0">
      <Ellipse.Fill>
        <RadialGradientBrush>
          <GradientStop Color="#4D3D8BF2" Offset="0"/>
          <GradientStop Color="#1A3D8BF2" Offset="0.45"/>
          <GradientStop Color="#003D8BF2" Offset="1"/>
        </RadialGradientBrush>
      </Ellipse.Fill>
    </Ellipse>
    <Ellipse x:Name="SplashRing" Width="150" Height="150" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="#9CC8FF" StrokeThickness="1.5"
             Opacity="0" RenderTransformOrigin="0.5,0.5">
      <Ellipse.RenderTransform><ScaleTransform/></Ellipse.RenderTransform>
    </Ellipse>
    <TextBlock x:Name="SplashName" Text="Nook" FontFamily="{StaticResource DisplayFont}" FontSize="30" FontWeight="Bold" Foreground="{DynamicResource TextFill}"
               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,236,0,0" Opacity="0">
      <TextBlock.RenderTransform><TranslateTransform/></TextBlock.RenderTransform>
    </TextBlock>
    <Grid x:Name="SplashLogo" Width="112" Height="112" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
      <Grid.RenderTransform>
        <TransformGroup>
          <ScaleTransform/>
          <RotateTransform/>
          <TranslateTransform/>
        </TransformGroup>
      </Grid.RenderTransform>
      <Border x:Name="SplashTile" CornerRadius="26" Background="#EB141C2E" BorderBrush="#40A9CBFF" BorderThickness="1.5" RenderTransformOrigin="0.5,0.5">
        <Border.Effect><DropShadowEffect BlurRadius="40" ShadowDepth="10" Direction="270" Opacity="0.35"/></Border.Effect>
        <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
      </Border>
      <Canvas>
        <Rectangle x:Name="Sq0" Canvas.Left="17" Canvas.Top="17" Width="35" Height="35" RadiusX="8" RadiusY="8" Fill="#3D8BF2" RenderTransformOrigin="0.5,0.5">
          <Rectangle.RenderTransform><TransformGroup><ScaleTransform/><TranslateTransform/></TransformGroup></Rectangle.RenderTransform>
        </Rectangle>
        <Rectangle x:Name="Sq1" Canvas.Left="60" Canvas.Top="17" Width="35" Height="35" RadiusX="8" RadiusY="8" Fill="#7AB4FF" RenderTransformOrigin="0.5,0.5">
          <Rectangle.RenderTransform><TransformGroup><ScaleTransform/><TranslateTransform/></TransformGroup></Rectangle.RenderTransform>
        </Rectangle>
        <Rectangle x:Name="Sq2" Canvas.Left="17" Canvas.Top="60" Width="35" Height="35" RadiusX="8" RadiusY="8" Fill="#1A55C4" RenderTransformOrigin="0.5,0.5">
          <Rectangle.RenderTransform><TransformGroup><ScaleTransform/><TranslateTransform/></TransformGroup></Rectangle.RenderTransform>
        </Rectangle>
        <Rectangle x:Name="Sq3" Canvas.Left="60" Canvas.Top="60" Width="35" Height="35" RadiusX="8" RadiusY="8" Fill="#5A9EF8" RenderTransformOrigin="0.5,0.5">
          <Rectangle.RenderTransform><TransformGroup><ScaleTransform/><TranslateTransform/></TransformGroup></Rectangle.RenderTransform>
        </Rectangle>
      </Canvas>
    </Grid>
  </Grid>
</Grid>
