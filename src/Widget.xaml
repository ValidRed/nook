<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Width="{Binding Width}" Height="{Binding Height}" Background="Transparent" UseLayoutRounding="True"
      TextElement.FontFamily="{StaticResource TextFont}" TextElement.Foreground="{Binding TextBrush}" TextElement.FontSize="12">
  <Grid.ContextMenu>
    <ContextMenu>
      <MenuItem Header="Open" Tag="&#xE8A7;" Command="{Binding OpenCommand}"/>
      <MenuItem Header="Edit group" Tag="&#xE70F;" Command="{Binding EditCommand}"/>
      <MenuItem Header="Open WinGroups" Tag="&#xE80F;" Command="{Binding OpenHubCommand}"/>
      <MenuItem Header="Close widgets" Tag="&#xE711;" Command="{Binding CloseAllCommand}"/>
    </ContextMenu>
  </Grid.ContextMenu>

  <!-- 1x1: looks and behaves like a desktop icon, but opens with one click -->
  <Button Style="{StaticResource DesktopIcon}" Command="{Binding OpenCommand}" Margin="1"
          Visibility="{Binding IsCompact, Converter={StaticResource BoolVis}}" AutomationProperties.Name="{Binding Name}">
    <StackPanel Margin="0,4,0,0">
      <Border Width="44" Height="44" BorderThickness="1" Padding="4" Background="{Binding TileBrush}"
              BorderBrush="{Binding TileStroke}" CornerRadius="{Binding TileRadius}">
        <ItemsControl ItemsSource="{Binding Preview}" Focusable="False">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><UniformGrid Rows="2" Columns="2"/></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Width="15" Height="15" Margin="1.5">
                <Border CornerRadius="4" Background="{DynamicResource SubtleFill}" Visibility="{Binding IsEmpty, Converter={StaticResource BoolVis}}"/>
                <Image Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality"/>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>
      <TextBlock Text="{Binding Name}" Foreground="White" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="3,3,3,0">
        <TextBlock.Effect><DropShadowEffect ShadowDepth="1" BlurRadius="3" Opacity="0.85" Color="Black" Direction="270"/></TextBlock.Effect>
      </TextBlock>
    </StackPanel>
  </Button>

  <!-- Bigger: a panel that shows the apps, one click to launch -->
  <Border Margin="3" CornerRadius="14" Background="{Binding PanelBrush}" BorderBrush="{Binding StrokeBrush}" BorderThickness="1"
          Visibility="{Binding IsPanel, Converter={StaticResource BoolVis}}">
    <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.22"/></Border.Effect>
    <DockPanel Margin="5">
      <!-- Title: only the pill around the name is clickable; it lights up on hover -->
      <Button DockPanel.Dock="Top" Style="{StaticResource WidgetTitle}" Height="24" HorizontalAlignment="Center"
              Command="{Binding OpenCommand}" ToolTip="Show all apps" AutomationProperties.Name="{Binding Name}">
        <TextBlock Text="{Binding Name}" Foreground="{Binding TextBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
      </Button>
      <ItemsControl ItemsSource="{Binding Slots}" Focusable="False">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Button Style="{StaticResource WidgetApp}" Foreground="{Binding TextBrush}" Width="{Binding Width}" Height="{Binding Height}" Command="{Binding Command}"
                    ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name}">
              <Button.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="Open" Tag="&#xE8A7;" Command="{Binding Command}"/>
                  <MenuItem Header="Run as administrator" Tag="&#xE7EF;" Command="{Binding AdminCommand}" Visibility="{Binding IsApp, Converter={StaticResource BoolVis}}"/>
                  <MenuItem Header="Remove from group" Tag="&#xE74D;" Command="{Binding RemoveCommand}" Visibility="{Binding IsApp, Converter={StaticResource BoolVis}}"/>
                </ContextMenu>
              </Button.ContextMenu>
              <Grid>
                <StackPanel VerticalAlignment="Center" Visibility="{Binding IsApp, Converter={StaticResource BoolVis}}">
                  <Image Source="{Binding Icon}" Width="{Binding IconSize}" Height="{Binding IconSize}" RenderOptions.BitmapScalingMode="HighQuality"/>
                  <TextBlock Text="{Binding Name}" FontSize="11" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"
                             Visibility="{Binding ShowName, Converter={StaticResource BoolVis}}"/>
                </StackPanel>
                <Border Width="{Binding IconSize}" Height="{Binding IconSize}" CornerRadius="8"
                        Background="{Binding HoverBrush}"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsMore, Converter={StaticResource BoolVis}}">
                  <TextBlock Text="{Binding MoreText}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
              </Grid>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </DockPanel>
  </Border>
</Grid>
