<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        TextElement.Foreground="{DynamicResource TextFill}"
        TextElement.FontFamily="{StaticResource TextFont}"
        TextElement.FontSize="14"
        Padding="12,10,12,14" MinWidth="300" UseLayoutRounding="True" Background="Transparent">
  <StackPanel>
    <Grid Height="40" Margin="0,0,0,4">
      <TextBlock Text="{Binding Name}" FontFamily="{StaticResource DisplayFont}" FontSize="16" FontWeight="SemiBold"
                 HorizontalAlignment="Center" VerticalAlignment="Center" Margin="44,0" TextTrimming="CharacterEllipsis"/>
      <Button Style="{StaticResource IconButton}" Width="34" Height="34" HorizontalAlignment="Right" Command="{Binding EditCommand}"
              ToolTip="Edit group" AutomationProperties.Name="Edit group">
        <TextBlock Style="{StaticResource Glyph}" Text="&#xE70F;" FontSize="14"/>
      </Button>
    </Grid>

    <ItemsControl x:Name="AppsList" ItemsSource="{Binding Apps}" Width="{Binding PanelWidth}" HorizontalAlignment="Center" Focusable="False"
                  Visibility="{Binding HasApps, Converter={StaticResource BoolVis}}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel ItemWidth="100"/>
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Button Style="{StaticResource PopupApp}" Width="96" Margin="2" Command="{Binding LaunchCommand}"
                  ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name}">
            <Button.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Open" Tag="&#xE8A7;" Command="{Binding LaunchCommand}"/>
                <MenuItem Header="Run as administrator" Tag="&#xE7EF;" Command="{Binding AdminCommand}"/>
                <MenuItem Header="Remove from group" Tag="&#xE74D;" Command="{Binding RemoveCommand}"/>
              </ContextMenu>
            </Button.ContextMenu>
            <StackPanel>
              <Image Source="{Binding Icon}" Width="40" Height="40" RenderOptions.BitmapScalingMode="HighQuality"/>
              <TextBlock Text="{Binding Name}" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                         MaxHeight="32" Margin="0,8,0,0"
                         Visibility="{Binding DataContext.ShowNames, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolVis}}"/>
            </StackPanel>
          </Button>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <StackPanel Visibility="{Binding IsEmpty, Converter={StaticResource BoolVis}}" Margin="12,8,12,8">
      <TextBlock Text="This group doesn’t have any apps yet." Foreground="{DynamicResource TextFill2}" HorizontalAlignment="Center"/>
      <Button Style="{StaticResource AccentButton}" Command="{Binding EditCommand}" HorizontalAlignment="Center" Margin="0,14,0,0">
        <StackPanel Orientation="Horizontal">
          <TextBlock Style="{StaticResource Glyph}" Text="&#xE710;" FontSize="14" Margin="0,0,8,0"/>
          <TextBlock Text="Add apps"/>
        </StackPanel>
      </Button>
    </StackPanel>
  </StackPanel>
</Border>
